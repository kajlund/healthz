{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "e2e/**/*.ts",
    "vite.config.ts",
    "playwright.config.ts",
    "test/**/*.ts",
    "vitest.config.ts"
  ]
}

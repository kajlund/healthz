{
  "name": "healthz",
  "version": "0.1.0",
  "description": "A personal health tracking application.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @healthz/api",
    "dev:web": "npm run dev -w @healthz/web",
    "build": "npm run build:web && npm run build:api",
    "build:api": "npm run build -w @healthz/api",
    "build:web": "npm run build -w @healthz/web",
    "start": "npm start -w @healthz/api",
    "test": "npm test --workspaces --if-present",
    "test:browser": "npm run test:browser -w @healthz/web --",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "verify:start": "node scripts/verify-start.mjs",
    "db:generate": "npm run db:generate -w @healthz/api --",
    "db:migrate": "npm run db:migrate -w @healthz/api --",
    "db:seed:healthcare-tags": "npm run db:seed:healthcare-tags -w @healthz/api --",
    "import:history": "npm run import:history -w @healthz/api --",
    "import:blood-pressure": "npm run import:blood-pressure -w @healthz/api --",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "@eslint/js": "10.0.1",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "typescript-eslint": "8.69.0",
    "globals": "14.0.0"
  }
}
